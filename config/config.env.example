# argus-tty machine config — NON-SECRET settings only.
#
# Copy this file to /etc/argus-tty/config.env during install (install.sh does
# this automatically the first time — it will NOT overwrite an existing one).
# Installed mode is 644 root:root — world-readable, root-writable only.
# Everything in this file is safe to be world-readable: S3 upload
# authenticates via this instance's IAM role (no access keys to manage), and
# SMTP_HOST/PORT below are just an endpoint address. The actual SMTP
# username/password live in a SEPARATE file,
# /etc/argus-tty/smtp-credentials.env (600, root-only) — see
# config/smtp-credentials.env.example — because argus-tty-wrapper and
# argus-tty-finalize run as the connecting developer's own uid and need to
# read THIS file, but must never be able to read real credentials.
#
# Required IAM permission on the instance role:
#   s3:PutObject   on  arn:aws:s3:::<S3_BUCKET>/<S3_PREFIX>/*
#
# None of this is required for session recording to work. If S3_UPLOAD_ENABLED
# is false, or the aws CLI isn't installed, or no credentials/IAM role
# resolve, argus-tty-finalize detects that up front and silently skips the S3
# upload for that session (logged via `logger -t argus-tty`) — sessions are
# still recorded locally under /var/log/argus-tty/sessions/, and this check
# never delays login or holds a developer's connection open at logout. Email
# notifications work the same way: argus-tty-wrapper just queues a small
# local file, and the separate argus-tty-mailer service (root-only, systemd
# timer) does the actual SMTP send, retrying a few times before giving up —
# this also never touches a live session.
#
# EMAIL_ENABLED and S3_UPLOAD_ENABLED are both master on/off switches, not
# just advisory: `argus-tty reconfigure` runs `systemctl enable --now
# argus-tty-mailer.timer` ONLY if EMAIL_ENABLED=true, and `systemctl disable
# --now` it otherwise, so the mailer never even runs on a box where email is
# turned off. S3 upload has no long-running daemon to enable/disable the same
# way — S3_UPLOAD_ENABLED instead gates the upload logic itself, inside
# argus-tty-finalize, every time a session ends.

# ── S3 ──────────────────────────────────────────────────────────────────────
# Master on/off switch for shipping session recordings to S3. Disabled by
# default, same pattern as EMAIL_ENABLED below — flip to true only once
# S3_BUCKET/AWS_REGION are filled in and the instance's IAM role actually has
# s3:PutObject on that bucket/prefix (see above). When false, argus-tty-
# finalize exits immediately for every session without even checking for the
# aws CLI or credentials — sessions still record locally under
# /var/log/argus-tty/sessions/ either way.
S3_UPLOAD_ENABLED=false
# Also leave blank to skip S3 upload even if S3_UPLOAD_ENABLED=true above —
# belt and suspenders, since a blank bucket has nowhere to upload to anyway.
S3_BUCKET=
S3_PREFIX=argus-tty
AWS_REGION=us-east-1

# ── Email notifications on session start/end (sent via SMTP by the separate
#    argus-tty-mailer service — see smtp-credentials.env.example for the
#    actual username/password) ────────────────────────────────────────────
# Master on/off switch. Disabled by default — flip to true once EMAIL_TO/
# FROM/SMTP_HOST below and smtp-credentials.env are actually filled in for
# your org. This directly controls whether argus-tty-mailer.timer is enabled
# (true) or disabled (false) via systemctl — see the note above.
EMAIL_ENABLED=false
EMAIL_TO=you@example.com
EMAIL_FROM=argus-tty@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587

# ── SSH hardening for the developer/admin groups (applied in sshd_config) ──
# no = block outright; yes = allow. Kept locked down by default, matching the
# original per-key authorized_keys options this replaces. Applies to both
# groups — admins get full sudo once connected, but the same TTY-forwarding
# restrictions on the SSH transport itself.
ALLOW_AGENT_FORWARDING=no
ALLOW_TCP_FORWARDING=no
ALLOW_X11_FORWARDING=no

# ── Skip full TTY (.tty) capture for specific non-interactive commands ─────
# argus-tty-wrapper ALWAYS skips `script`-based TTY capture for scp/rsync/
# git-over-ssh (git-upload-pack/git-receive-pack/git-upload-archive) —
# unconditionally, NOT affected by NO_CAPTURE_COMMAND_PATTERN below. That's
# not a policy choice like the rest of this section: `script` PTY-wraps
# whatever it runs, and wrapping a binary wire protocol in a PTY can corrupt
# it outright rather than just growing the .tty file — e.g. scp failing
# with "Ensure the remote shell produces no output for non-interactive
# sessions". There is no way to turn this exclusion off.
#
# Separately, and this IS a policy choice you can customize: there is NO
# built-in default beyond the above — every other command gets full `.tty`
# capture unless you opt a pattern in here. If your own deploy tooling has a
# long-running log-tail subcommand (whose live-streamed byte-for-byte output
# isn't meaningful to store and would otherwise grow the .tty file unbounded
# for as long as the connection stays open), set an extended regex here
# (bash `=~`, i.e. ERE) to skip capture for it — e.g.:
#   NO_CAPTURE_COMMAND_PATTERN='^tail[[:space:]]+.*(-f|--follow)|^journalctl[[:space:]]+.*(-f|--follow)'
# Leave unset/blank for full capture on every command (the default).
#
# This ONLY affects the .tty transcript. It never affects .meta (which
# always has the exact command, timestamps, and exit code), the session
# start/end email notifications, or the `logger -t argus-tty` audit events
# — those fire unchanged no matter what matches here. Keep this narrow: a
# command that could have skipped capture but didn't just means the normal,
# fully-recorded behavior (safe); a pattern that's too broad is the only way
# this setting could actually reduce the audit trail.
NO_CAPTURE_COMMAND_PATTERN=

# ── Lite recording: skip full .tty capture for specific users, keep
#    .hist/.meta/notifications ──────────────────────────────────────────────
# Space-separated usernames (matched against `id -un`, exact match only).
# Unlike NO_CAPTURE_COMMAND_PATTERN (which is about WHICH COMMAND), this is
# about WHICH ACCOUNT: every session for a listed user skips `script`-based
# TTY recording entirely (interactive or not), but .hist (command history)
# and .meta (who/when/exit code) are captured exactly like any other forced
# session — this account still needs AllowGroups access via its own primary
# group (see reconfigure.sh) to log in at all. Intended for a pre-existing
# privileged account (e.g. the cloud-init default 'ubuntu' user) you want
# audited without recording every keystroke of a byte-for-byte terminal.
LITE_RECORDING_USERS=ubuntu

# ── Two-factor authentication (Google Authenticator / TOTP) for SSH ────────
# Master on/off switch. Disabled by default, same pattern as EMAIL_ENABLED/
# S3_UPLOAD_ENABLED above. When true, `argus-tty reconfigure`:
#   - installs libpam-google-authenticator if it isn't already,
#   - requires a TOTP code (in addition to the SSH key) for every developer
#     AND admin session, via a managed block in /etc/pam.d/sshd,
#   - EXEMPTS the deployer tier and any username in LITE_RECORDING_USERS
#     above (e.g. the cloud-init 'ubuntu' account) — those never go through
#     `argus-tty add`'s onboarding pipeline, so they'd never get a TOTP
#     secret provisioned; making them subject to a mandatory OTP prompt
#     would just lock them out.
# `sudo argus-tty add`/`add-admin` auto-provision a TOTP secret for new
# developer/admin accounts at onboarding time (printed once, like the
# generated PEM key) — see README.md "Two-factor authentication" for the
# full flow, including how to reset a lost secret.
# Setting this to true does NOT retroactively enroll existing accounts —
# re-run `sudo argus-tty add <username>` (or add-admin) for each one first,
# so nobody gets locked out by a mandatory prompt with no secret behind it.
GOOGLE_2FA_ENABLED=false

# ── Customizing the developer/admin/deployer tier names ────────────────────
# The three tiers are called 'developer'/'admin'/'deployer' everywhere by
# default — the actual Linux group, sudoers %group rules, the sshd
# AllowGroups/Match block, and the PAM 2FA exemption all key off whatever
# you set here. Leave these as-is unless your org wants different
# terminology (e.g. 'engineer'/'sre'/'release').
#
# Renaming a tier that ALREADY has onboarded accounts is safe: `argus-tty
# reconfigure` detects the old canonical group still exists and renames it
# in place (`groupmod -n`), preserving every existing account's access,
# rather than leaving them behind in an orphaned group. As with any change
# that touches sshd's AllowGroups/Match block, test a NEW connection in a
# separate terminal before closing your current session.
#
# The CLI's canonical verbs (`add`, `add-admin`, `add-deployer`,
# `list-admins`, etc.) always keep working no matter what you set below —
# renaming only ADDS a synonym. E.g. ADMIN_GROUP_NAME=sre also makes
# `add-sre`/`bulk-add-sres`/`remove-sre`/`list-sres` work, alongside
# `add-admin`/`bulk-add-admins`/`remove-admin`/`list-admins`.
#
# On-disk paths (/etc/sudoers.d/developer, /etc/argus-tty/developer.sudoers,
# /usr/share/argus-tty/developer.sudoers.sample, etc.) are NOT affected by
# these — they stay on the canonical developer/admin/deployer names as
# internal identifiers, regardless of what you rename the actual group to.
DEVELOPER_GROUP_NAME=developer
ADMIN_GROUP_NAME=admin
DEPLOYER_GROUP_NAME=deployer
