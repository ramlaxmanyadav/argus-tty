# SMTP credentials for argus-tty email notifications.
#
# Copied to /etc/argus-tty/smtp-credentials.env during install
# (root:root 600 — root-only readable). ONLY argus-tty-mailer (which runs
# as root, driven by the argus-tty-mailer.timer systemd unit) ever reads
# this file. argus-tty-wrapper (which runs as the connecting developer's
# own uid) never sees it — developer sessions cannot read SMTP credentials
# under any circumstance, they can only queue a notification for the mailer
# to send later.
#
# If you're using AWS SES's SMTP interface, these are SES SMTP credentials
# (NOT your IAM access key/secret — generate them separately):
#   https://docs.aws.amazon.com/ses/latest/dg/smtp-credentials.html
# Any other SMTP relay (Postfix, SendGrid, Mailgun, etc.) works the same way
# — just point SMTP_HOST/PORT in config.env at it.

SMTP_USER=
SMTP_PASS=
